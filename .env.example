# ---------------------------------------------------------------
# TaskEarn environment variables. Copy to .env and fill in.
# Never commit a real .env file. Never expose these to the client.
# ---------------------------------------------------------------

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/taskearn?schema=public"

# Auth — generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_COOKIE_NAME="taskearn_session"
AUTH_SESSION_TTL_HOURS="168"

# Public app URL (used for referral links, emails, OpenGraph)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------
# Survey providers — leave blank until you hold commercial access.
# When blank, the surveys module reports "Survey provider is not configured."
# ---------------------------------------------------------------

# CPX Research — publisher.cpx-research.com -> Apps
#   CPX_API_KEY is the "secure hash" string, not a bearer token. CPX uses it in
#   both directions, so CPX_WEBHOOK_SECRET is optional and falls back to it.
# Postback URL to paste into the CPX dashboard (Postback Settings tab):
#   https://YOUR_DOMAIN/api/webhooks/surveys/cpx?status={status}&trans_id={trans_id}
#     &user_id={user_id}&amount_local={amount_local}&amount_usd={amount_usd}
#     &offer_id={offer_id}&hash={secure_hash}&subid_1={subid_1}
CPX_API_KEY=""
CPX_APP_ID=""
CPX_WEBHOOK_SECRET=""

# Pollfish — Developer Dashboard -> Account Information
#   POLLFISH_SIGNED_PARAMS must list, in order, exactly the template parameters
#   your postback URL substitutes. Pollfish signs the concatenated values, so a
#   mismatch here fails every callback.
# Postback URL:
#   https://YOUR_DOMAIN/api/webhooks/surveys/pollfish?tx_id=[[tx_id]]
#     &click_id=[[click_id]]&cpa=[[cpa]]&timestamp=[[timestamp]]
#     &status=[[status]]&signature=[[signature]]
POLLFISH_API_KEY=""
POLLFISH_WEBHOOK_SECRET=""
POLLFISH_SIGNED_PARAMS="tx_id,click_id,cpa,timestamp"

# BitLabs — Publisher Dashboard -> Apps -> Integration
#   The hash parameter must stay LAST in the callback URL; BitLabs signs the
#   whole URL up to it and the check cannot be reproduced otherwise.
# Reward callback:
#   https://YOUR_DOMAIN/api/webhooks/surveys/bitlabs?uid=[%UID%]&val=[%VAL%]
#     &raw=[%RAW%]&tx=[%TX%]&type=[%TYPE%]
BITLABS_API_KEY=""
BITLABS_WEBHOOK_SECRET=""

# Optional second gate on postbacks: comma-separated provider IPs.
# Leave blank to accept any source — the signature is the real authentication,
# and a half-filled allowlist silently drops real callbacks.
SURVEY_POSTBACK_IP_ALLOWLIST=""

# Minor units of the platform currency per 1 USD. Providers quote publisher
# revenue in USD; the ledger is in paisa. 28000 = PKR 280.00 per USD.
USD_RATE_MINOR="28000"

# ---------------------------------------------------------------
# Payout providers — leave blank until you hold merchant credentials.
# When blank, withdrawals stay in manual admin processing mode.
# ---------------------------------------------------------------
JAZZCASH_API_KEY=""
JAZZCASH_MERCHANT_ID=""
EASYPAISA_API_KEY=""
EASYPAISA_MERCHANT_ID=""

# ---------------------------------------------------------------
# Crypto gateway (USDT) — custodial. The platform holds no keys and signs no
# transactions; the gateway issues addresses, watches the chain and calls back.
# Webhook: https://YOUR_DOMAIN/api/webhooks/payments/crypto
# ---------------------------------------------------------------
CRYPTO_GATEWAY_API_KEY=""
CRYPTO_GATEWAY_API_URL=""
CRYPTO_GATEWAY_WEBHOOK_SECRET=""
# Chains accepted, comma-separated: TRC20,ERC20,BEP20,POLYGON
CRYPTO_NETWORKS="TRC20"
# Confirmations before a deposit is treated as final. Do not lower this to make
# testing quicker — a re-org after activation is unrecoverable.
CRYPTO_MIN_CONFIRMATIONS="19"
# Minor units of the platform currency per 1 USDT.
CRYPTO_USDT_RATE_MINOR="28000"

# ---------------------------------------------------------------
# Exchange rails (OKX / Binance) — an ALTERNATIVE to the gateway above.
#
# Pay out directly from an exchange account instead of a hosted processor.
# It is cheaper and you keep custody. Read all four warnings first.
#
# 1. A withdrawal-enabled API key IS the account. If it leaks, the balance
#    leaves and there is no chargeback. Always set the exchange's IP allowlist,
#    and keep only a working float in the account — not the treasury.
# 2. Exchange terms of service. Both OKX and Binance restrict using an ordinary
#    account to pay third parties on behalf of a business. Accounts doing this
#    get frozen with the funds inside. Talk to their institutional/broker desk
#    before you route customer payouts through a retail account.
# 3. Deposits cannot be attributed by address. An exchange gives you ONE USDT
#    address per chain, shared by every member. Attribution is done by quoting
#    each member a unique amount and matching it. That works at low volume and
#    breaks at high volume — see src/lib/payments/exchanges/index.ts.
# 4. There are no deposit webhooks. Everything is polled from /api/maintenance,
#    so payments land within one poll interval, not instantly.
#
# Leave CRYPTO_EXCHANGE blank to keep using the hosted gateway instead.
# ---------------------------------------------------------------
CRYPTO_EXCHANGE=""              # "binance" | "okx" | blank

# Paste this from the exchange yourself. A wrong value sends every member's
# payment somewhere unrecoverable.
CRYPTO_DEPOSIT_ADDRESS=""

BINANCE_API_KEY=""
BINANCE_API_SECRET=""

OKX_API_KEY=""
OKX_API_SECRET=""
OKX_API_PASSPHRASE=""

# Blast radius of any bug in the payout loop. Keep it small.
CRYPTO_MAX_PAYOUTS_PER_RUN="20"

# ---------------------------------------------------------------
# Stripe — membership fees only.
# Webhook: https://YOUR_DOMAIN/api/webhooks/payments/stripe
# Subscribe it to: checkout.session.completed, checkout.session.expired,
#   checkout.session.async_payment_succeeded, checkout.session.async_payment_failed,
#   charge.refunded, charge.dispute.created
#
# NOTE: Stripe prohibits get-rich-quick and investment schemes. What is sold
# through this integration is a fixed-term subscription to a larger daily task
# allowance. Keep it described that way everywhere, including in your Stripe
# account's business description — it is the first thing a reviewer reads.
# ---------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Payouts need a Connect account per recipient. Leave false until that exists.
STRIPE_PAYOUT_ENABLED="false"

# Scheduled maintenance endpoint (/api/maintenance).
# Leave blank to disable the endpoint entirely. Generate with: openssl rand -hex 32
# Call it with:  Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""

# Email (architecture only — no provider wired by default)
EMAIL_FROM="no-reply@taskearn.example"
EMAIL_PROVIDER_API_KEY=""
